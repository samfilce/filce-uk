---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Caravan Awning Parts Compatibility Guide UK 2026 — Measure Width, Drop & Fittings';
const description = 'Measure caravan awning width, drop, rail profile, slider type and end-cap style, then route to the right replacement part or accessory search with tracked CTAs.';
const canonicalPath = '/caravan-awning-parts-compatibility-guide/';

const related = {
  careFinder: '/caravan-awning-care-finder/',
  repairEstimator: '/caravan-awning-repair-estimator/',
  seasonalChecklist: '/caravan-awning-seasonal-checklist/',
  brandFitMatrix: '/caravan-awning-brand-fit-matrix/',
  moistureControl: '/posts/best-caravan-moisture-control-products-for-winter-storage-uk/',
};

const amazon = {
  railSliders: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+sliders&tag=filce-21',
  endCaps: 'https://www.amazon.co.uk/s?k=caravan+awning+end+caps&tag=filce-21',
  railStrips: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+strips&tag=filce-21',
  railStoppers: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+stoppers&tag=filce-21',
  poleClips: 'https://www.amazon.co.uk/s?k=caravan+awning+pole+clips&tag=filce-21',
  tensionStraps: 'https://www.amazon.co.uk/s?k=awning+tension+straps&tag=filce-21',
  spareParts: 'https://www.amazon.co.uk/s?k=caravan+awning+replacement+parts&tag=filce-21',
};

const faqItems = [
  {
    question: 'Do I need the exact awning brand?',
    answer: 'Sometimes, but the rail profile, slider type and end-cap shape are often the fastest way to narrow the fit.',
  },
  {
    question: 'What if the width is close but not exact?',
    answer: 'Stay with the closest compatible part family and double-check the seller notes, because a few centimetres can matter.',
  },
  {
    question: 'When should I switch to repair content?',
    answer: 'If the issue is torn fabric, leaking seams, or UV cracking, the repair estimator is the better next stop.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="website" category="Tools">
  <section class="hero-shell">
    <div class="container hero-grid">
      <div class="card hero-copy">
        <p class="eyebrow">Compatibility guide · caravan awnings</p>
        <h1>Match the part to the awning before you order the wrong spare.</h1>
        <p class="lede">
          This page is for owners who already know they need a replacement part or accessory, but are not sure which fitting family they need. Measure the width and drop, identify the rail, slider and end-cap style, then send the visitor to the right part search instead of a generic awning listing.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="#compatibility" data-plausible-event="awning_parts_jump_click" data-plausible-prop-surface="hero">Check compatibility</a>
          <a class="btn secondary" href={related.repairEstimator} data-plausible-event="awning_parts_repair_estimator_click" data-plausible-prop-surface="hero">Open the repair estimator</a>
          <a class="btn green" href={related.careFinder} data-plausible-event="awning_parts_care_finder_click" data-plausible-prop-surface="hero">Compare care products</a>
        </div>
        <p class="microcopy">Revenue mechanism: fit-intent traffic gets routed into part-family searches, reducing wasted clicks on incompatible spares and lifting the chance of a product-page conversion.</p>
        <p class="small help-link">Need help narrowing the part family from brand and hardware clues? <a href={related.brandFitMatrix} data-plausible-event="awning_parts_help_link_click" data-plausible-prop-surface="hero-help">Read the brand fit matrix</a>.</p>
        <p class="small help-link">Want a seasonal maintenance pass before you measure more parts? <a href={related.seasonalChecklist} data-plausible-event="awning_parts_seasonal_checklist_help_link_click" data-plausible-prop-surface="hero-help">Open the seasonal checklist</a>.</p>
      </div>

      <div class="card hero-panel" aria-label="Compatibility summary">
        <div class="metric">
          <div class="label">Start with dimensions</div>
          <div class="value">Width + drop</div>
          <div class="sub">good fit begins with the right size band</div>
        </div>
        <div class="metric">
          <div class="label">Then check fittings</div>
          <div class="value">Rail, slider, end cap</div>
          <div class="sub">match the hardware family before you buy</div>
        </div>
        <div class="metric">
          <div class="label">Best for accessories</div>
          <div class="value">Strips, stoppers, spare caps</div>
          <div class="sub">small parts often solve the annoying jobs</div>
        </div>
        <div class="metric">
          <div class="label">Best next buy</div>
          <div class="value" id="hero-buy">Rail sliders</div>
          <div class="sub" id="hero-sub">the part family most compatibility shoppers need first</div>
        </div>
      </div>
    </div>
  </section>

  <section class="finder-section">
    <div class="container finder-grid-2">
      <div class="card chooser" id="compatibility">
        <h2 class="section-title">Awning parts compatibility checker</h2>
        <p class="section-subtitle">Set the size and fitting style you have in front of you. The recommendation updates instantly with the best matching part family and a backup accessory search.</p>

        <div class="field-grid">
          <label class="field">
            <span>Awnings width</span>
            <input id="width" type="range" min="180" max="450" step="5" value="300" />
            <div class="range-row"><span>180 cm</span><span id="width-label">300 cm</span><span>450 cm</span></div>
          </label>

          <label class="field">
            <span>Awning drop</span>
            <input id="drop" type="range" min="120" max="300" step="5" value="230" />
            <div class="range-row"><span>120 cm</span><span id="drop-label">230 cm</span><span>300 cm</span></div>
          </label>

          <label class="field">
            <span>Rail style</span>
            <select id="rail">
              <option value="keder">Keder / bead rail</option>
              <option value="channel">Standard awning rail channel</option>
              <option value="cassette">Cassette / box rail</option>
              <option value="unsure">Not sure yet</option>
            </select>
          </label>

          <label class="field">
            <span>Slider / carrier style</span>
            <select id="slider">
              <option value="ring">Ring slider / hanging loop</option>
              <option value="screw">Screw-in slider / bracket</option>
              <option value="clip">Clip slider / quick-release</option>
              <option value="unsure">I’m not certain</option>
            </select>
          </label>

          <label class="field">
            <span>End-cap style</span>
            <select id="endCap">
              <option value="plastic">Plastic end cap</option>
              <option value="metal">Metal end plate</option>
              <option value="rubber">Rubber cap / bumper</option>
              <option value="unsure">No idea yet</option>
            </select>
          </label>
        </div>

        <div class="results" aria-live="polite">
          <div class="result-card">
            <div class="result-label">Recommended part family</div>
            <div class="result-title" id="result-title">Rail sliders and bead-compatible fittings</div>
            <div class="result-copy" id="result-copy">Match the rail profile first, then buy the slider family that actually fits the track.</div>
          </div>

          <div class="result-card">
            <div class="result-label">Best backup search</div>
            <div class="result-title" id="result-secondary">Replacement end-cap set</div>
            <div class="result-copy" id="result-secondary-copy">If the spare part is no longer available, the end-cap or bracket family is often the closest compatible route.</div>
          </div>

          <div class="result-card">
            <div class="result-label">Suggested action</div>
            <div class="result-copy" id="result-action">Open the matched part search below, then compare the measurements before ordering. If the issue is damaged fabric rather than fit, switch to the repair estimator.</div>
          </div>

          <div class="cta-row compact">
            <a class="btn primary" id="primary-link" href={amazon.railSliders} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_primary_click" data-plausible-prop-surface="results">Check part search</a>
            <a class="btn secondary" id="secondary-link" href={amazon.endCaps} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_secondary_click" data-plausible-prop-surface="results">See backup search</a>
            <button class="btn green" type="button" id="copy-brief" data-plausible-event="awning_parts_copy_brief_click" data-plausible-prop-surface="results">Copy fit brief</button>
          </div>
          <p class="small status" id="copy-status" aria-live="polite"></p>
        </div>
      </div>

      <aside class="card sidebar">
        <h2 class="section-title">Fast compatibility rules</h2>
        <ul class="rules">
          <li><strong>Measure the width:</strong> compare the rail span and note the size band before buying.</li>
          <li><strong>Measure the drop:</strong> this helps separate compact porch kits from deeper awnings.</li>
          <li><strong>Match the rail:</strong> bead, channel and cassette fittings are not interchangeable.</li>
          <li><strong>Photograph the end cap:</strong> small differences in the cap shape can break compatibility.</li>
          <li><strong>If fabric is torn:</strong> move to the repair estimator instead of forcing a parts fit.</li>
        </ul>

        <div class="cta-stack">
          <a class="btn primary" href={amazon.railSliders} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_slider_search_click" data-plausible-prop-surface="sidebar">Shop rail sliders</a>
          <a class="btn secondary" href={amazon.endCaps} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_endcap_search_click" data-plausible-prop-surface="sidebar">Shop end caps</a>
          <a class="btn secondary" href={amazon.railStrips} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_strip_search_click" data-plausible-prop-surface="sidebar">Shop rail strips</a>
          <a class="btn secondary" href={amazon.railStoppers} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_stopper_search_click" data-plausible-prop-surface="sidebar">Shop rail stoppers</a>
          <a class="btn secondary" href={amazon.poleClips} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_clip_search_click" data-plausible-prop-surface="sidebar">Shop pole clips</a>
          <a class="btn secondary" href={amazon.tensionStraps} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_strap_search_click" data-plausible-prop-surface="sidebar">Shop tension straps</a>
        </div>
        <p class="small help-link">Want the brand-level version first? <a href={related.brandFitMatrix} data-plausible-event="awning_parts_brand_matrix_help_click" data-plausible-prop-surface="sidebar-help">Read the brand fit matrix</a>.</p>
      </aside>
    </div>
  </section>

  <section class="comparison-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Best part by fitting problem</h2>
        <p class="section-sub">Use the right part family for the hardware you actually have, not the cheapest generic listing.</p>
      </div>

      <div class="comparison-grid">
        <article class="product-card">
          <p class="product-kicker">Rail fit</p>
          <h3>Rail sliders and bead-compatible fittings</h3>
          <p>Best when the awning rides on a bead or rail and the moving part needs to match the track profile exactly.</p>
          <a href={amazon.railSliders} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_product_slider_click" data-plausible-prop-surface="comparison">View current search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Rail extension</p>
          <h3>Rail strips and additional rail sections</h3>
          <p>Best when the rail run needs extending, replacing, or matching across a wider awning span.</p>
          <a href={amazon.railStrips} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_product_strip_click" data-plausible-prop-surface="comparison">View current search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">End cap fit</p>
          <h3>Rail stoppers and end-cap replacement set</h3>
          <p>Best when the visible problem is a brittle cap, a lost stopper, or a missing side plate rather than a fabric fault.</p>
          <a href={amazon.endCaps} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_product_endcap_click" data-plausible-prop-surface="comparison">View current search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Accessory fit</p>
          <h3>Pole clips and tension straps</h3>
          <p>Best when the awning is broadly fine but you need the small accessory that keeps it anchored, tidy, or easier to use.</p>
          <a href={amazon.poleClips} target="_blank" rel="noopener sponsored" data-plausible-event="awning_parts_product_clip_click" data-plausible-prop-surface="comparison">View current search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Support</p>
          <h3>Measure first, buy second</h3>
          <p>If the part family is unclear, take width, drop, rail and end-cap photos before clicking through to the next search.</p>
          <a href={related.seasonalChecklist} data-plausible-event="awning_parts_product_checklist_click" data-plausible-prop-surface="comparison">Open the checklist</a>
        </article>
      </div>
    </div>
  </section>

  <section class="guide-section">
    <div class="container guide-grid">
      <article class="card guide-card">
        <h2>How to measure compatibility</h2>
        <p>Measure the awning width across the rail, then measure the drop from the rail to the bottom edge. Add a photo of the rail profile, slider, and end cap. Those three images usually tell you more than a vague model name.</p>
        <div class="cta-row">
          <a class="btn primary" href={related.seasonalChecklist} data-plausible-event="awning_parts_checklist_mid_click" data-plausible-prop-surface="guide">Open the checklist</a>
          <a class="btn secondary" href={related.repairEstimator} data-plausible-event="awning_parts_repair_mid_click" data-plausible-prop-surface="guide">Open the repair estimator</a>
        </div>
        <p class="small">For winter-storage prep, compare with <a href={related.moistureControl} data-plausible-event="awning_parts_moisture_related_click" data-plausible-prop-surface="guide">the moisture-control comparison</a>.</p>
      </article>

      <article class="card guide-card">
        <h2>What this page is selling</h2>
        <ul>
          <li>Width and drop traffic gets sorted into the right size band.</li>
          <li>Rail, slider and end-cap traffic gets pushed to the correct spare-part family.</li>
          <li>Accessory buyers get clips, straps, and small-fit extras instead of random awning searches.</li>
          <li>Repair-intent traffic gets sent away from the fit guide before it bounces.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="faq-section">
    <div class="container faq-grid">
      <article class="card faq-card">
        <h2>FAQ</h2>
        <details>
          <summary>Do I need the exact awning brand?</summary>
          <p>Sometimes, but the rail profile, slider type and end-cap shape are often the fastest way to narrow the fit.</p>
        </details>
        <details>
          <summary>What if the width is close but not exact?</summary>
          <p>Stay with the closest compatible part family and double-check the seller notes, because a few centimetres can matter.</p>
        </details>
        <details>
          <summary>When should I switch to repair content?</summary>
          <p>If the issue is torn fabric, leaking seams, or UV cracking, the repair estimator is the better next stop.</p>
        </details>
      </article>

      <article class="card faq-card">
        <h2>Affiliate disclosure</h2>
        <p>Some links on this page are affiliate links. If someone buys through them, I may earn a commission at no extra cost to the buyer. That helps fund the site and keeps the buying guides free.</p>
        <p class="small">For related awning content, compare with <a href={related.careFinder}>Caravan awning care finder</a>, <a href={related.seasonalChecklist}>seasonal checklist</a> and the repair estimator above.</p>
      </article>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <section class="container card copy-card" style="margin-bottom: 4rem;">
    <div class="copy-grid">
      <div>
        <h3>Copyable fit brief</h3>
        <p>Use this when you want a quick note to paste into messages, shopping lists, or a browser search.</p>
        <textarea id="brief-output" readonly></textarea>
      </div>
      <div class="copy-actions">
        <button type="button" class="btn primary" id="copy-fit-brief" data-plausible-event="awning_parts_copy_click" data-plausible-prop-surface="copy-panel">Copy fit brief</button>
        <p class="small status" id="copy-status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <script>
    const state = {
      width: 300,
      drop: 230,
      rail: 'keder',
      slider: 'ring',
      endCap: 'plastic',
    };

    const urls = {
      railSliders: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+sliders&tag=filce-21',
      endCaps: 'https://www.amazon.co.uk/s?k=caravan+awning+end+caps&tag=filce-21',
      poleClips: 'https://www.amazon.co.uk/s?k=caravan+awning+pole+clips&tag=filce-21',
      tensionStraps: 'https://www.amazon.co.uk/s?k=awning+tension+straps&tag=filce-21',
      spareParts: 'https://www.amazon.co.uk/s?k=caravan+awning+replacement+parts&tag=filce-21',
    };

    const els = {
      width: document.getElementById('width'),
      drop: document.getElementById('drop'),
      rail: document.getElementById('rail'),
      slider: document.getElementById('slider'),
      endCap: document.getElementById('endCap'),
      widthLabel: document.getElementById('width-label'),
      dropLabel: document.getElementById('drop-label'),
      heroBuy: document.getElementById('hero-buy'),
      heroSub: document.getElementById('hero-sub'),
      resultTitle: document.getElementById('result-title'),
      resultCopy: document.getElementById('result-copy'),
      resultSecondary: document.getElementById('result-secondary'),
      resultSecondaryCopy: document.getElementById('result-secondary-copy'),
      resultAction: document.getElementById('result-action'),
      primaryLink: document.getElementById('primary-link'),
      secondaryLink: document.getElementById('secondary-link'),
      copyBrief: document.getElementById('copy-fit-brief'),
      briefOutput: document.getElementById('brief-output'),
      copyStatus: document.getElementById('copy-status'),
    };

    function sizeBand(width) {
      if (width < 240) return 'compact';
      if (width < 330) return 'mid';
      return 'large';
    }

    function dropBand(drop) {
      if (drop < 180) return 'shallow';
      if (drop < 250) return 'standard';
      return 'deep';
    }

    function railLabel(rail) {
      if (rail === 'keder') return 'keder / bead rail';
      if (rail === 'channel') return 'standard awning rail channel';
      if (rail === 'cassette') return 'cassette / box rail';
      return 'unknown rail profile';
    }

    function sliderLabel(slider) {
      if (slider === 'ring') return 'ring slider / hanging loop';
      if (slider === 'screw') return 'screw-in slider / bracket';
      if (slider === 'clip') return 'clip slider / quick-release';
      return 'unknown slider style';
    }

    function endCapLabel(endCap) {
      if (endCap === 'plastic') return 'plastic end cap';
      if (endCap === 'metal') return 'metal end plate';
      if (endCap === 'rubber') return 'rubber cap / bumper';
      return 'unknown end-cap style';
    }

    function pickRecommendation() {
      const size = sizeBand(state.width);
      const drop = dropBand(state.drop);

      if (state.rail === 'cassette') {
        return {
          title: 'Cassette-specific end caps and replacement fittings',
          copy: `Your ${railLabel(state.rail)} points to parts that match the housing, not generic sliders. Pair the width (${state.width} cm) and drop (${state.drop} cm) with the seller photos before you buy.`,
          secondary: 'Cassette bracket or housing accessory set',
          secondaryCopy: 'When a cassette fitting is missing or brittle, the bracket and housing family is the next best search.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: verify the cassette photo, then buy the exact housing-compatible spare part.`,
          primary: urls.endCaps,
          secondaryUrl: urls.spareParts,
        };
      }

      if (state.endCap === 'rubber') {
        return {
          title: 'Rail stoppers and end-cap replacement set',
          copy: `A ${endCapLabel(state.endCap)} usually means the stop or bumper has failed, so the best search is the stopper/end-cap family rather than a general spare. Keep the width (${state.width} cm) and drop (${state.drop} cm) handy for the seller photos.`,
          secondary: 'Replacement end-cap set',
          secondaryCopy: 'If the stopper is missing but the cap still matches, the end-cap family is the safest backup search.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: buy the stopper or end-cap family first, then compare the photos against the rail profile.`,
          primary: urls.railStoppers,
          secondaryUrl: urls.endCaps,
        };
      }

      if (state.rail === 'channel' && size === 'large') {
        return {
          title: 'Rail strips and additional rail sections',
          copy: `A ${railLabel(state.rail)} with a large width band (${state.width} cm) usually points to longer rail runs or replacement sections, not just sliders. Match the section length against the seller photos before ordering.`,
          secondary: 'Rail slider and spacer pack',
          secondaryCopy: 'If the rail section itself is fine, the slider and spacer family is the next backup search.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: confirm the rail strip or section length, then compare with the replacement section listing.`,
          primary: urls.railStrips,
          secondaryUrl: urls.railSliders,
        };
      }

      if (state.rail === 'channel' || state.slider === 'screw') {
        return {
          title: 'Rail sliders and screw-fit fittings',
          copy: `A ${railLabel(state.rail)} plus a ${sliderLabel(state.slider)} usually means the slider family matters more than the awning brand. Use the width (${state.width} cm) and drop (${state.drop} cm) to narrow the size.`,
          secondary: 'Replacement end-cap set',
          secondaryCopy: 'If the slider is fine but a cap or stop has failed, the end-cap family is the safer backup search.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: buy the slider family that matches the track, then add end caps if the stops are worn.`,
          primary: urls.railSliders,
          secondaryUrl: urls.endCaps,
        };
      }

      if (state.slider === 'clip') {
        return {
          title: 'Quick-release clip sliders and accessory packs',
          copy: `A ${sliderLabel(state.slider)} usually means the compatibility problem is the clip geometry, not the awning fabric. Check the width (${state.width} cm) and drop (${state.drop} cm) against the listing photos.`,
          secondary: 'Pole clips and tie-down accessories',
          secondaryCopy: 'If the main part is unclear, the accessory pack often gives the nearest fit-friendly spare first.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: use the clip-slider search first, then consider the accessory pack.`,
          primary: urls.poleClips,
          secondaryUrl: urls.tensionStraps,
        };
      }

      if (drop === 'deep') {
        return {
          title: 'Tension straps and deep-drop accessory sets',
          copy: `A deeper drop around ${state.drop} cm usually benefits from a stronger accessory search, especially when the rail is otherwise standard. Keep the width (${state.width} cm) in mind, because larger canopies often need extra support.`,
          secondary: 'Rail slider and spacer pack',
          secondaryCopy: 'If the straps are not the issue, the slider and spacer family is the next item to compare.',
          action: `Width band: ${size}. Drop band: ${drop}. Best route: start with the accessory kit, then compare slider fit if the part is still uncertain.`,
          primary: urls.tensionStraps,
          secondaryUrl: urls.railSliders,
        };
      }

      return {
        title: 'Rail sliders and bead-compatible fittings',
        copy: `The default fit path for a ${railLabel(state.rail)} is a slider family that matches the track profile. Pair that with the width (${state.width} cm) and drop (${state.drop} cm) so you do not buy an almost-right spare.`,
        secondary: 'Replacement end-cap set',
        secondaryCopy: 'A brittle cap or stop is the most common backup search when the main fitting is otherwise fine.',
        action: `Width band: ${size}. Drop band: ${drop}. Best route: confirm the rail photo, then buy the slider family and spare caps if needed.`,
        primary: urls.railSliders,
        secondaryUrl: urls.endCaps,
      };
    }

    function formatBrief(recommendation) {
      return [
        `Width: ${state.width} cm`,
        `Drop: ${state.drop} cm`,
        `Rail: ${railLabel(state.rail)}`,
        `Slider: ${sliderLabel(state.slider)}`,
        `End cap: ${endCapLabel(state.endCap)}`,
        `Recommended part: ${recommendation.title}`,
        `Backup search: ${recommendation.secondary}`,
      ].join('\n');
    }

    function update() {
      const recommendation = pickRecommendation();
      const size = sizeBand(state.width);
      const drop = dropBand(state.drop);

      els.widthLabel.textContent = `${state.width} cm`;
      els.dropLabel.textContent = `${state.drop} cm`;
      els.heroBuy.textContent = recommendation.title;
      els.heroSub.textContent = `${size} width / ${drop} drop fit path`;
      els.resultTitle.textContent = recommendation.title;
      els.resultCopy.textContent = recommendation.copy;
      els.resultSecondary.textContent = recommendation.secondary;
      els.resultSecondaryCopy.textContent = recommendation.secondaryCopy;
      els.resultAction.textContent = recommendation.action;
      els.primaryLink.href = recommendation.primary;
      els.secondaryLink.href = recommendation.secondaryUrl;
      els.briefOutput.value = formatBrief(recommendation);
    }

    const setState = (key, value) => {
      state[key] = value;
      update();
    };

    els.width.addEventListener('input', (event) => setState('width', Number(event.target.value)));
    els.drop.addEventListener('input', (event) => setState('drop', Number(event.target.value)));
    els.rail.addEventListener('change', (event) => setState('rail', event.target.value));
    els.slider.addEventListener('change', (event) => setState('slider', event.target.value));
    els.endCap.addEventListener('change', (event) => setState('endCap', event.target.value));

    els.copyBrief.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(els.briefOutput.value);
        els.copyStatus.textContent = 'Fit brief copied to clipboard.';
      } catch (error) {
        els.copyStatus.textContent = 'Copy failed — select the text and copy it manually.';
      }
    });

    update();
  </script>
</BaseLayout>
