---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Caravan Awning Repair Estimator UK 2026 — Diagnose the Fix Before You Buy';
const description = 'Estimate whether a caravan awning needs seam sealer, patch tape, zip repair, UV treatment, or replacement parts, then route readers to the right buy link fast.';
const canonicalPath = '/caravan-awning-repair-estimator/';

const posts = {
  cleaner: '/posts/best-caravan-awning-cleaner-uk-2026/',
  explainer: '/posts/awning-cleaner-vs-reproofer-vs-seam-sealer-uk-2026/',
  careFinder: '/caravan-awning-care-finder/',
  seasonalChecklist: '/caravan-awning-seasonal-checklist/',
  partsGuide: '/caravan-awning-parts-compatibility-guide/',
  brandFitMatrix: '/caravan-awning-brand-fit-matrix/',
  moistureControl: '/posts/best-caravan-moisture-control-products-for-winter-storage-uk/',
};

const amazon = {
  repairKit: 'https://www.amazon.co.uk/s?k=caravan+awning+repair+kit&tag=filce-21',
  patchTape: 'https://www.amazon.co.uk/s?k=awning+repair+patch+tape&tag=filce-21',
  seamSealer: 'https://www.amazon.co.uk/s?k=seam+sealer+awning&tag=filce-21',
  uvProtect: 'https://www.amazon.co.uk/s?k=fabric+uv+protectant+spray&tag=filce-21',
  zipSlider: 'https://www.amazon.co.uk/s?k=awning+zip+slider+replacement&tag=filce-21',
  replacementParts: 'https://www.amazon.co.uk/s?k=caravan+awning+replacement+parts&tag=filce-21',
};

const faqItems = [
  {
    question: 'Should I clean before repairing?',
    answer: 'Yes. A clean, dry surface gives repair products the best chance to stick and last.',
  },
  {
    question: 'When is replacement better than repair?',
    answer: 'If the damage is panel-wide, the fabric is brittle, or multiple faults keep returning, replacement parts usually make more sense.',
  },
  {
    question: 'Does a UV spray fix cracked fabric?',
    answer: 'No. It helps protect healthy material, but it will not rebuild fabric that is already cracking or falling apart.',
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="website" category="Tools">
  <section class="hero-shell">
    <div class="container hero-grid">
      <div class="card hero-copy">
        <p class="eyebrow">Repair-intent funnel · caravan awnings</p>
        <h1>Work out the likely awning repair before you spend on the wrong thing.</h1>
        <p class="lede">
          This page is for visitors who already know something is broken, leaking, cracking, or snagging. It estimates the likely fix, rough effort, and sensible buy path so repair-intent traffic converts into the correct seam sealer, patch kit, zip part, UV spray, or replacement accessory click.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="#estimator" data-plausible-event="awning_repair_estimator_jump_click" data-plausible-prop-surface="hero">Estimate my repair</a>
          <a class="btn secondary" href={posts.explainer} data-plausible-event="awning_repair_estimator_explainer_click" data-plausible-prop-surface="hero">Read the repair explainer</a>
          <a class="btn green" href={posts.careFinder} data-plausible-event="awning_repair_estimator_care_finder_click" data-plausible-prop-surface="hero">Compare care products</a>
        </div>
        <p class="microcopy">Revenue mechanism: visitors with repair intent are routed to the exact product category or replacement accessory search instead of a generic awning-cleaning pitch.</p>
        <p class="small help-link">Need help deciding between seam sealer, patch tape, and replacement parts? <a href={posts.explainer} data-plausible-event="awning_repair_estimator_help_link_click" data-plausible-prop-surface="hero-help">Read the repair explainer</a>.</p>
        <p class="small help-link">Want a pre-buy upkeep checklist first? <a href={posts.seasonalChecklist} data-plausible-event="awning_repair_estimator_seasonal_checklist_help_link_click" data-plausible-prop-surface="hero-help">Open the seasonal checklist</a>.</p>
      </div>

      <div class="card hero-panel" aria-label="Repair summary">
        <div class="metric">
          <div class="label">Best for seam leaks</div>
          <div class="value">Seam sealer</div>
          <div class="sub">fix stitching leaks before you think about cleaning again</div>
        </div>
        <div class="metric">
          <div class="label">Best for tears</div>
          <div class="value">Patch kit</div>
          <div class="sub">small tears can be patched quickly if the fabric still has life</div>
        </div>
        <div class="metric">
          <div class="label">Best for brittle UV damage</div>
          <div class="value">Replace or protect</div>
          <div class="sub">once fabric is cracking, replacement accessories can be the better buy</div>
        </div>
        <div class="metric">
          <div class="label">Best next step</div>
          <div class="value" id="hero-buy">Repair kit</div>
          <div class="sub" id="hero-sub">route the visitor to the cheapest fix that still solves the real fault</div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section related-reading-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Related reading</h2>
        <p class="section-sub">If the fault is not obvious yet, keep moving through the awning support cluster before you buy the wrong repair product.</p>
      </div>
      <div class="card">
        <ul class="rules">
          <li><a href={posts.explainer} data-track-event="awning_repair_estimator_explainer_related_click" data-track-surface="related-reading">Read the repair explainer</a></li>
          <li><a href={posts.careFinder} data-track-event="awning_repair_estimator_care_finder_related_click" data-track-surface="related-reading">Compare the care products</a></li>
          <li><a href={posts.seasonalChecklist} data-track-event="awning_repair_estimator_checklist_related_click" data-track-surface="related-reading">Use the seasonal checklist</a></li>
          <li><a href={posts.partsGuide} data-track-event="awning_repair_estimator_parts_related_click" data-track-surface="related-reading">Check the parts compatibility guide</a></li>
          <li><a href={posts.brandFitMatrix} data-track-event="awning_repair_estimator_brand_matrix_related_click" data-track-surface="related-reading">Open the brand fit matrix</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="finder-section">
    <div class="container finder-grid-2">
      <div class="card chooser" id="estimator">
        <h2 class="section-title">Awning repair estimator</h2>
        <p class="section-subtitle">Pick the visible fault, how bad it looks, and how soon it needs fixing. The recommendation updates instantly with a cost band and effort estimate.</p>

        <div class="field-grid">
          <label class="field">
            <span>Main fault</span>
            <select id="fault">
              <option value="seam">Leaks through stitching or pinholes</option>
              <option value="tear">Fabric tear, split, or abrasion hole</option>
              <option value="zip">Sticky zip, rail, or slider issue</option>
              <option value="uv">Faded, brittle, or cracked UV-damaged fabric</option>
              <option value="unsure">Not sure yet / mixed symptoms</option>
            </select>
          </label>

          <label class="field">
            <span>Damage size</span>
            <select id="size">
              <option value="tiny">Tiny — a few millimetres / isolated leak</option>
              <option value="hand">Hand-sized — small patch or split</option>
              <option value="panel">Panel-wide — larger section or multiple failures</option>
            </select>
          </label>

          <label class="field">
            <span>Urgency</span>
            <select id="urgency">
              <option value="soon">Soon — before the next trip</option>
              <option value="now">Now — water ingress or unusable</option>
              <option value="later">Later — keep using it for now</option>
            </select>
          </label>

          <label class="field">
            <span>Budget ceiling</span>
            <input id="budget" type="range" min="5" max="80" step="1" value="22" />
            <div class="range-row"><span>£5</span><span id="budget-label">£22</span><span>£80</span></div>
          </label>
        </div>

        <div class="results" aria-live="polite">
          <div class="result-card">
            <div class="result-label">Likely fix</div>
            <div class="result-title" id="result-title">Seam sealer or repair tape</div>
            <div class="result-copy" id="result-copy">If the leak is from stitching or tiny holes, a seam repair product is the right first buy.</div>
          </div>

          <div class="result-grid">
            <div class="result-card">
              <div class="result-label">Estimated cost band</div>
              <div class="result-title" id="result-cost">£8–£18</div>
              <div class="result-copy" id="result-cost-copy">A small repair is usually the cheapest route, especially if the fabric is otherwise healthy.</div>
            </div>
            <div class="result-card">
              <div class="result-label">Estimated effort</div>
              <div class="result-title" id="result-effort">30–60 minutes</div>
              <div class="result-copy" id="result-effort-copy">Enough time to clean, dry, and apply the fix properly without rushing the job.</div>
            </div>
          </div>

          <div class="result-card callout">
            <div class="result-label">When to repair vs replace</div>
            <div class="result-copy" id="result-action">Repair is usually sensible when the issue is localised and the fabric is still flexible. If the damage is panel-wide or brittle, replacement parts become more attractive.</div>
          </div>

          <div class="cta-row compact">
            <a class="btn primary" id="primary-link" href={amazon.seamSealer} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_primary_click" data-plausible-prop-surface="results">Check price</a>
            <a class="btn secondary" id="secondary-link" href={amazon.patchTape} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_secondary_click" data-plausible-prop-surface="results">See backup option</a>
            <button class="btn green" type="button" id="copy-brief" data-plausible-event="awning_repair_estimator_copy_brief_click" data-plausible-prop-surface="results">Copy repair brief</button>
          </div>
          <p class="small status" id="copy-status" aria-live="polite"></p>
        </div>
      </div>

      <aside class="card sidebar">
        <h2 class="section-title">Fast repair rules</h2>
        <ul class="rules">
          <li><strong>Stitching leak:</strong> use seam sealer, not cleaner.</li>
          <li><strong>Small tear:</strong> patch tape or a repair kit usually beats replacement.</li>
          <li><strong>Sticky zip / slider:</strong> replace or lubricate the moving part before forcing it.</li>
          <li><strong>UV cracking:</strong> if the fabric feels brittle, replacement accessories may be the better ROI.</li>
          <li><strong>Always dry first:</strong> repair products stick better on a clean, dry surface.</li>
        </ul>

        <div class="cta-stack">
          <a class="btn primary" href={amazon.repairKit} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_repair_kit_click" data-plausible-prop-surface="sidebar">Shop repair kits</a>
          <a class="btn secondary" href={amazon.seamSealer} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_seam_click" data-plausible-prop-surface="sidebar">Shop seam sealer</a>
          <a class="btn secondary" href={amazon.uvProtect} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_uv_click" data-plausible-prop-surface="sidebar">Shop UV protection</a>
          <a class="btn secondary" href={amazon.replacementParts} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_parts_click" data-plausible-prop-surface="sidebar">Shop replacement parts</a>
        </div>

        <p class="small help-link">Need a slower diagnosis before you buy? <a href={posts.explainer} data-plausible-event="awning_repair_estimator_help_article_click" data-plausible-prop-surface="sidebar-help">Read the repair explainer</a>.</p>
      </aside>
    </div>
  </section>

  <section class="comparison-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Best buy by repair type</h2>
        <p class="section-sub">The estimator routes visitors to the category most likely to solve the fault without overspending.</p>
      </div>

      <div class="comparison-grid">
        <article class="product-card">
          <p class="product-kicker">Seam repair</p>
          <h3>Seam sealer and waterproof repair tape</h3>
          <p>Best for pinholes, stitching leaks, and other localised water ingress where the awning itself is still usable.</p>
          <a href={amazon.seamSealer} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_product_seam_click" data-plausible-prop-surface="comparison">View current price</a>
        </article>
        <article class="product-card">
          <p class="product-kicker">Tear repair</p>
          <h3>Caravan awning repair kit</h3>
          <p>Best when the fabric has a small split or abrasion hole and you want the cheapest practical repair first.</p>
          <a href={amazon.repairKit} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_product_repairkit_click" data-plausible-prop-surface="comparison">View current price</a>
        </article>
        <article class="product-card">
          <p class="product-kicker">Zip / slider</p>
          <h3>Replacement slider or zip part</h3>
          <p>Best when the fault is mechanical rather than fabric-based and you can fix the moving part instead of replacing the canopy.</p>
          <a href={amazon.zipSlider} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_product_zip_click" data-plausible-prop-surface="comparison">View current price</a>
        </article>
        <article class="product-card">
          <p class="product-kicker">UV / aging</p>
          <h3>UV protectant or replacement accessories</h3>
          <p>Best when the fabric is still broadly intact but needs protection, or when it is too brittle and replacement becomes the cleaner solution.</p>
          <a href={amazon.uvProtect} target="_blank" rel="noopener sponsored" data-plausible-event="awning_repair_estimator_product_uv_click" data-plausible-prop-surface="comparison">View current price</a>
        </article>
      </div>
    </div>
  </section>

  <section class="guide-section">
    <div class="container guide-grid">
      <article class="card guide-card">
        <h2>How to use the estimator</h2>
        <p>Choose the fault you can see, then check whether the damage is tiny, hand-sized, or panel-wide. The result should tell you whether to repair, patch, protect, or move to replacement parts.</p>
        <div class="cta-row">
          <a class="btn primary" href={posts.explainer} data-plausible-event="awning_repair_estimator_explainer_mid_click" data-plausible-prop-surface="guide">Read the explainer</a>
          <a class="btn secondary" href={posts.cleaner} data-plausible-event="awning_repair_estimator_cleaner_mid_click" data-plausible-prop-surface="guide">Read the cleaner guide</a>
        </div>
        <p class="small">For winter-storage prep, compare with <a href={posts.moistureControl} data-plausible-event="awning_repair_moisture_related_click" data-plausible-prop-surface="guide">the moisture-control comparison</a>.</p>
      </article>

      <article class="card guide-card">
        <h2>What this page is selling</h2>
        <ul>
          <li>Seam leaks get routed to seam sealer or repair tape.</li>
          <li>Tears get routed to a repair kit before a replacement upsell.</li>
          <li>UV damage gets routed to protection or replacement accessories depending on severity.</li>
          <li>Sticky zips and sliders get a mechanical fix instead of a cleaning product.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="faq-section">
    <div class="container faq-grid">
      <article class="card faq-card">
        <h2>FAQ</h2>
        <details>
          <summary>Should I clean before repairing?</summary>
          <p>Yes. A clean, dry surface gives repair products the best chance to stick and last.</p>
        </details>
        <details>
          <summary>When is replacement better than repair?</summary>
          <p>If the damage is panel-wide, the fabric is brittle, or multiple faults keep returning, replacement parts usually make more sense.</p>
        </details>
        <details>
          <summary>Does a UV spray fix cracked fabric?</summary>
          <p>No. It helps protect healthy material, but it will not rebuild fabric that is already cracking or falling apart.</p>
        </details>
      </article>

      <article class="card faq-card">
        <h2>Affiliate disclosure</h2>
        <p>Some links on this page are affiliate links. If someone buys through them, I may earn a commission at no extra cost to the buyer. That helps fund the site and keeps the buying guides free.</p>
        <p class="small">For the comparison route, see <a href={posts.careFinder}>Caravan awning care finder</a> and the explainer above.</p>
      </article>
    </div>
  </section>

  <section class="container card copy-card" style="margin-bottom: 4rem;">
    <div class="copy-grid">
      <div>
        <h3>Copyable repair brief</h3>
        <p>Use this when you want a quick summary to paste into notes, DMs, or a shopping list.</p>
        <textarea id="brief-output" readonly></textarea>
      </div>
      <div class="copy-actions">
        <button type="button" class="btn primary" id="copy-brief" data-plausible-event="awning_repair_estimator_copy_click" data-plausible-prop-surface="copy-panel">Copy repair brief</button>
        <p class="small status" id="copy-status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer,
      },
    })),
  })} />

  <script>
    const state = {
      fault: 'seam',
      size: 'tiny',
      urgency: 'soon',
      budget: 22,
    };

    const urls = {
      repairKit: 'https://www.amazon.co.uk/s?k=caravan+awning+repair+kit&tag=filce-21',
      patchTape: 'https://www.amazon.co.uk/s?k=awning+repair+patch+tape&tag=filce-21',
      seamSealer: 'https://www.amazon.co.uk/s?k=seam+sealer+awning&tag=filce-21',
      uvProtect: 'https://www.amazon.co.uk/s?k=fabric+uv+protectant+spray&tag=filce-21',
      zipSlider: 'https://www.amazon.co.uk/s?k=awning+zip+slider+replacement&tag=filce-21',
      replacementParts: 'https://www.amazon.co.uk/s?k=caravan+awning+replacement+parts&tag=filce-21',
    };

    const els = {
      fault: document.getElementById('fault'),
      size: document.getElementById('size'),
      urgency: document.getElementById('urgency'),
      budget: document.getElementById('budget'),
      budgetLabel: document.getElementById('budget-label'),
      resultTitle: document.getElementById('result-title'),
      resultCopy: document.getElementById('result-copy'),
      resultCost: document.getElementById('result-cost'),
      resultCostCopy: document.getElementById('result-cost-copy'),
      resultEffort: document.getElementById('result-effort'),
      resultEffortCopy: document.getElementById('result-effort-copy'),
      resultAction: document.getElementById('result-action'),
      primaryLink: document.getElementById('primary-link'),
      secondaryLink: document.getElementById('secondary-link'),
      copyBrief: document.getElementById('copy-brief'),
      copyStatus: document.getElementById('copy-status'),
      briefOutput: document.getElementById('brief-output'),
      heroBuy: document.getElementById('hero-buy'),
      heroSub: document.getElementById('hero-sub'),
    };

    function money(value) {
      return `£${Number(value).toFixed(0)}`;
    }

    function copyText(text, statusMessage) {
      try {
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
        } else {
          fallbackCopy(text);
        }
        if (els.copyStatus) els.copyStatus.textContent = statusMessage;
      } catch (err) {
        console.error(err);
        if (els.copyStatus) els.copyStatus.textContent = 'Clipboard blocked, but the repair brief is still visible on screen.';
      }
    }

    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', 'true');
      ta.style.position = 'absolute';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }

    function buildRepairPlan() {
      const { fault, size, urgency, budget } = state;

      let title = 'Seam sealer or repair tape';
      let copy = 'If the fault is a stitching leak or tiny hole, a seam repair product is the most direct fix.';
      let cost = '£8–£18';
      let costCopy = 'A small repair usually stays in the lowest cost band if the fabric is otherwise healthy.';
      let effort = '30–60 minutes';
      let effortCopy = 'Enough time to clean, dry, and apply the fix properly without rushing.';
      let action = 'Repair is usually sensible when the issue is localised and the fabric still flexes normally.';
      let primaryUrl = urls.seamSealer;
      let secondaryUrl = urls.patchTape;
      let heroBuy = 'Seam sealer';
      let heroSub = 'best first buy for stitching leaks and tiny pinholes';

      if (fault === 'tear') {
        title = 'Repair kit or patch tape';
        copy = 'A small fabric tear is usually best handled with a repair kit before you think about replacing the whole awning.';
        primaryUrl = urls.repairKit;
        secondaryUrl = urls.patchTape;
        heroBuy = 'Repair kit';
        heroSub = 'best first buy for small splits and abrasion holes';
        cost = size === 'panel' ? '£18–£35' : '£10–£24';
        costCopy = size === 'panel'
          ? 'A wider tear may still patch, but costs and effort start rising quickly.'
          : 'A small tear usually stays cheap unless the surrounding fabric is brittle.';
        effort = size === 'panel' ? '1–2 hours' : '45–90 minutes';
        effortCopy = 'Patch jobs need a clean surface and careful alignment, so do not rush the prep.';
        action = size === 'panel'
          ? 'If the tear is panel-wide, compare repair cost with replacement parts before buying.'
          : 'Patch first, then monitor whether the fabric keeps failing around the same spot.';
      }

      if (fault === 'zip') {
        title = 'Zip slider or rail part';
        copy = 'When the problem is mechanical, a moving part or lubricant is usually smarter than a fabric repair.';
        primaryUrl = urls.zipSlider;
        secondaryUrl = urls.repairKit;
        heroBuy = 'Zip slider replacement';
        heroSub = 'best first buy for stuck or broken moving parts';
        cost = '£6–£20';
        costCopy = 'Mechanical fixes are often cheaper than fabric repairs if you catch them early.';
        effort = urgency === 'now' ? '15–30 minutes' : '30–45 minutes';
        effortCopy = 'The job is usually quick if you can access the slider or rail cleanly.';
        action = 'Do not force a stuck zip. Fix the moving part before it tears the fabric around it.';
      }

      if (fault === 'uv') {
        title = 'UV protectant or replacement accessories';
        copy = 'UV damage changes the buying decision: protect healthy fabric, but replace brittle material that is already cracking.';
        primaryUrl = urls.uvProtect;
        secondaryUrl = urls.replacementParts;
        heroBuy = 'UV protectant';
        heroSub = 'best first buy if the fabric is still healthy enough to save';
        cost = size === 'panel' ? '£20–£60' : '£10–£28';
        costCopy = size === 'panel'
          ? 'Panel-wide UV wear often pushes you toward replacement accessories or a bigger repair basket.'
          : 'If the fabric is still flexible, a protectant can be a low-cost next step.';
        effort = size === 'panel' ? '1–2 hours' : '30–60 minutes';
        effortCopy = 'Protecting a healthy surface is faster than fixing a cracked one.';
        action = size === 'panel' || urgency === 'now'
          ? 'If the fabric feels brittle or powdery, replacement parts may produce a better long-term result.'
          : 'Use protectant only if the awning still has enough life left to benefit from it.';
      }

      if (fault === 'unsure') {
        title = 'Inspection first, then the right product';
        copy = 'If the fault is mixed or unclear, start by confirming whether the issue is a leak, tear, mechanical snag, or UV fatigue.';
        primaryUrl = urls.repairKit;
        secondaryUrl = urls.seamSealer;
        heroBuy = 'Inspection kit';
        heroSub = 'best first buy when the problem is not yet obvious';
        cost = '£5–£15';
        costCopy = 'The cheapest decision is often a better inspection before buying the wrong repair product.';
        effort = '20–40 minutes';
        effortCopy = 'A little diagnosis now stops you paying for the wrong product later.';
        action = 'Read the explainer and inspect the fault closely before buying anything expensive.';
      }

      if (size === 'hand' && fault !== 'zip') {
        cost = fault === 'uv' ? '£12–£32' : '£12–£28';
        effort = fault === 'tear' ? '1–2 hours' : '45–90 minutes';
      }

      if (size === 'panel') {
        cost = fault === 'uv' ? '£20–£60' : fault === 'tear' ? '£18–£35' : '£12–£30';
        effort = fault === 'zip' ? '30–60 minutes' : '1–2 hours';
        action = 'Panel-wide damage is where replacement parts start to compete with repairs on value.';
      }

      if (budget < 15 && fault !== 'zip') {
        secondaryUrl = urls.patchTape;
        costCopy = 'Low budgets usually favour a patch or sealant search first, then a bigger product only if needed.';
      }

      if (urgency === 'now') {
        action = 'Because this is urgent, prioritise the fastest fix that stops leaks or collapse rather than the most elegant long-term option.';
      } else if (urgency === 'later') {
        action = 'If it still works, keep using it briefly, but plan the repair before the fault spreads.';
      }

      const brief = [
        `Fault: ${fault}`,
        `Size: ${size}`,
        `Urgency: ${urgency}`,
        `Budget: ${money(budget)}`,
        '',
        `Likely fix: ${title}`,
        `Primary buy: ${heroBuy}`,
        `Secondary buy: ${secondaryUrl === urls.replacementParts ? 'Replacement parts' : secondaryUrl === urls.patchTape ? 'Patch tape' : 'Backup repair option'}`,
        `Estimated cost: ${cost}`,
        `Estimated effort: ${effort}`,
        '',
        action,
      ].join('\n');

      return { title, copy, cost, costCopy, effort, effortCopy, action, primaryUrl, secondaryUrl, heroBuy, heroSub, brief };
    }

    function render() {
      const plan = buildRepairPlan();
      els.budgetLabel.textContent = money(state.budget);
      els.resultTitle.textContent = plan.title;
      els.resultCopy.textContent = plan.copy;
      els.resultCost.textContent = plan.cost;
      els.resultCostCopy.textContent = plan.costCopy;
      els.resultEffort.textContent = plan.effort;
      els.resultEffortCopy.textContent = plan.effortCopy;
      els.resultAction.textContent = plan.action;
      els.primaryLink.href = plan.primaryUrl;
      els.secondaryLink.href = plan.secondaryUrl;
      els.heroBuy.textContent = plan.heroBuy;
      els.heroSub.textContent = plan.heroSub;
      els.briefOutput.value = plan.brief;
      els.copyBrief.onclick = () => copyText(plan.brief, 'Copied repair brief to clipboard.');
    }

    els.fault.addEventListener('change', () => {
      state.fault = els.fault.value;
      render();
    });

    els.size.addEventListener('change', () => {
      state.size = els.size.value;
      render();
    });

    els.urgency.addEventListener('change', () => {
      state.urgency = els.urgency.value;
      render();
    });

    els.budget.addEventListener('input', () => {
      state.budget = Number(els.budget.value);
      render();
    });

    render();
  </script>
</BaseLayout>
