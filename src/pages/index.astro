---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categorySlug, formatDate } from '../lib/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const featuredGuideSlugs = ['best-pet-monitoring-cameras-uk-2025', 'home-assistant-pet-monitoring'];
const featuredGuides = featuredGuideSlugs.map((slug) => posts.find((post) => post.slug === slug)).filter((post): post is NonNullable<typeof post> => Boolean(post));
---
<BaseLayout title="Filce.uk — Honest UK Tech Reviews, Home Automation & Gear" description="Real reviews of the tech, tools and gear Sam actually buys and uses. Home automation, 3D printing, homelabs, and more." canonicalPath="/">
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-eyebrow">Home Assistant guides from a UK tinkerer</p>
        <h1 class="hero-title">Home Assistant ideas.<br />From setups I actually use.</h1>
        <p class="hero-desc">Practical UK-focused reviews and guides for people who want automations that save time - not just smart-home gadgets that look good on paper.</p>
        <a href="#digital-products-heading" class="btn btn-primary">Explore the guide</a>
      </div>
    </div>
  </section>

  <section class="posts-section" aria-labelledby="digital-products-heading">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" id="digital-products-heading">Home Assistant that actually saves you time</h2>
        <p class="section-sub">One practical guide for a smoother setup, faster automations, and fewer dead ends.</p>
      </div>
      <div class="post-grid">
        <article class="post-card">
          <div class="post-card-placeholder" aria-hidden="true"><span>Guide</span></div>
          <div class="post-card-body">
            <h3 class="post-card-title">Build a Home Assistant setup that feels instant, not fiddly</h3>
            <p class="post-card-excerpt">A PDF + EPUB guide to installation, integrations, automations and private local AI - written from the systems I run at home.</p>
            <a href="https://samfilce.gumroad.com/l/ai-home-assistant-guide?utm_source=filce.uk&utm_medium=homepage&utm_campaign=ai-ha-guide" class="btn btn-primary" data-cta-track="ha-guide">Get the guide — £9.99</a>
            <p class="post-card-excerpt">Prefer ready-made automations? <a href="https://samfilce.gumroad.com/l/xurkli?utm_source=filce.uk&utm_medium=homepage&utm_campaign=ha-yaml-pack" data-cta-track="ha-yaml-pack">See the YAML pack</a>.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {featuredGuides.length > 0 && (
    <section class="posts-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Featured guides</h2>
          <p class="section-sub">High-intent guides built to help people choose, compare, and buy.</p>
        </div>

        <div class="post-grid">
          {featuredGuides.map((post) => (
            <article class="post-card">
              <div class="post-card-image">
                {post.featuredImage ? (
                  <img src={post.featuredImage} alt={post.featuredImageAlt ?? post.title} loading="lazy" />
                ) : (
                  <div class="post-card-placeholder" aria-hidden="true"><span>{post.category ?? 'Guide'}</span></div>
                )}
              </div>
              <div class="post-card-body">
                {post.category && <a href={`/categories/${categorySlug(post.category)}/`} class="post-category-tag">{post.category}</a>}
                <h3 class="post-card-title"><a href={post.url}>{post.title}</a></h3>
                {post.description && <p class="post-card-excerpt">{post.description}</p>}
                <div class="post-card-meta">
                  <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
                  <span class="meta-sep">·</span>
                  <span>{post.readingTime}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Pet monitoring tools</h2>
        <p class="section-sub">The fastest route from “I need a setup” to the page or guide that fits.</p>
      </div>
      <div class="post-grid">
        <article class="post-card">
          <div class="post-card-image">
            <div class="post-card-placeholder" aria-hidden="true"><span>Finder</span></div>
          </div>
          <div class="post-card-body">
            <a href="/categories/home-automation/" class="post-category-tag">Home Automation</a>
            <h3 class="post-card-title"><a href="/pet-monitoring-setup-finder/" data-cta-track="pet-monitoring-finder-homepage-card">Pet monitoring setup finder</a></h3>
            <p class="post-card-excerpt">Route readers to the right Home Assistant pet monitoring path, then push them to the highest-fit Gumroad or camera CTA.</p>
            <div class="post-card-meta">
              <span>Interactive tool</span>
              <span class="meta-sep">·</span>
              <span>Revenue path</span>
            </div>
          </div>
        </article>
        <article class="post-card">
          <div class="post-card-image">
            <div class="post-card-placeholder" aria-hidden="true"><span>Guide</span></div>
          </div>
          <div class="post-card-body">
            <a href="/categories/pets/" class="post-category-tag">Pets</a>
            <h3 class="post-card-title"><a href="/posts/home-assistant-pet-monitoring/">Home Assistant pet monitoring</a></h3>
            <p class="post-card-excerpt">The core article that explains how I actually keep an eye on Ice with cameras, automations, and AI alerts.</p>
            <div class="post-card-meta">
              <span>Supporting content</span>
              <span class="meta-sep">·</span>
              <span>High intent</span>
            </div>
          </div>
        </article>
        <article class="post-card">
          <div class="post-card-image">
            <div class="post-card-placeholder" aria-hidden="true"><span>Review</span></div>
          </div>
          <div class="post-card-body">
            <a href="/categories/pets/" class="post-category-tag">Pets</a>
            <h3 class="post-card-title"><a href="/posts/reolink-fisheye-camera-review/">Reolink fisheye camera review</a></h3>
            <p class="post-card-excerpt">The hardware page that catches visitors who are already shopping for the camera that powers the setup.</p>
            <div class="post-card-meta">
              <span>Affiliate assist</span>
              <span class="meta-sep">·</span>
              <span>Buy-ready traffic</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Latest posts</h2>
        <p class="section-sub">Fresh from the workshop, server rack, or Amazon box.</p>
      </div>

      {posts.length ? (
        <div class="post-grid">
          {posts.map((post) => (
            <article class="post-card">
              <div class="post-card-image">
                {post.featuredImage ? (
                  <img src={post.featuredImage} alt={post.featuredImageAlt ?? post.title} loading="lazy" />
                ) : (
                  <div class="post-card-placeholder" aria-hidden="true"><span>{post.category ?? 'Review'}</span></div>
                )}
              </div>
              <div class="post-card-body">
                {post.category && <a href={`/categories/${categorySlug(post.category)}/`} class="post-category-tag">{post.category}</a>}
                <h3 class="post-card-title"><a href={post.url}>{post.title}</a></h3>
                {post.description && <p class="post-card-excerpt">{post.description}</p>}
                <div class="post-card-meta">
                  <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
                  <span class="meta-sep">·</span>
                  <span>{post.readingTime}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">Posts coming soon - check back shortly.</p>
      )}
    </div>
  </section>

  <section class="categories-section">
    <div class="container">
      <h2 class="section-title">Browse by category</h2>
      <div class="category-grid">
        <a href="/categories/tech/" class="category-card"><span class="category-icon">💻</span><span class="category-name">Tech</span></a>
        <a href="/categories/home-automation/" class="category-card"><span class="category-icon">🏠</span><span class="category-name">Home Automation</span></a>
        <a href="/categories/homelabs/" class="category-card"><span class="category-icon">🖥️</span><span class="category-name">Homelabs</span></a>
        <a href="/categories/gaming-accessories/" class="category-card"><span class="category-icon">🎮</span><span class="category-name">Gaming Accessories</span></a>
        <a href="/categories/tools/" class="category-card"><span class="category-icon">🔧</span><span class="category-name">Tools</span></a>
        <a href="/categories/home-renovation/" class="category-card"><span class="category-icon">🪚</span><span class="category-name">Home Renovation</span></a>
        <a href="/categories/3d-printing/" class="category-card"><span class="category-icon">🖨️</span><span class="category-name">3D Printing</span></a>
        <a href="/categories/photography-video/" class="category-card"><span class="category-icon">📷</span><span class="category-name">Photography & Video</span></a>
        <a href="/categories/pet/" class="category-card"><span class="category-icon">🐕</span><span class="category-name">Pet</span></a>
      </div>
    </div>
  </section>
  <script>
    const ctaLinks = document.querySelectorAll('[data-cta-track]');
    const trackHomeAssistantCta = (ctaName) => {
      const eventName = 'home_assistant_cta_click';
      const payload = { event: eventName, cta: ctaName };
      console.info(`[homepage] ${eventName}`, ctaName);
      window.dataLayer?.push?.(payload);
      window.plausible?.(eventName, { props: { cta: ctaName } });
      window.gtag?.('event', eventName, { cta_name: ctaName, transport_type: 'beacon' });
    };

    ctaLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const ctaName = link.dataset.ctaTrack;
        if (ctaName) trackHomeAssistantCta(ctaName);
      });
    });
  </script>
</BaseLayout>
