---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "HA Solar Production Forecaster + Battery Scheduler | Home Assistant YAML Pack";
const description = "Rule-based Home Assistant YAML pack that forecasts solar production and intelligently schedules your battery — no ML, no cloud, no subscriptions. Accurate 48h forecasts, tariff-aware automation, saves £200-£600+/year. One-time £19 purchase.";
const canonicalPath = "/ha-solar-forecaster/";
---

<BaseLayout 
  title={title} 
  description={description} 
  canonicalPath={canonicalPath}
  ogType="website"
>
  <div class="page-container">
    <div class="container">
      <header class="page-header">
        <h1>Stop Guessing Your Solar Output. Start Optimizing Your Battery Like a Pro.</h1>
        <p class="subtitle"><strong>Rule-based Home Assistant YAML pack that forecasts solar production and intelligently schedules your battery — no ML, no cloud, no subscriptions. Just reliable local automation.</strong></p>
      </header>

      <div class="page-content prose">
        <div class="section cta-section">
          <a 
            href="https://gumroad.com/l/ha-solar-forecaster?utm_source=filce_uk&utm_medium=sales_page&utm_campaign=solar_forecaster_pack" 
            class="cta-button"
            data-gumroad-product="ha-solar-forecaster"
          >
            Buy Now — £19 (one-time)
          </a>
          <p class="utm-note">Tracked purchase link. Opens Gumroad checkout. Revenue supports filce.uk.</p>
        </div>

        <div class="section proof">
          <h2>Why This Pack Wins</h2>
          <ul>
            <li>Accurate 48-hour solar production forecasts using free Open-Meteo API + your local weather</li>
            <li>Smart battery scheduling that charges on cheap tariffs and discharges during peaks — saves £200-£600+/year on typical UK setups</li>
            <li>Zero ongoing costs. 100% local. Works offline after initial setup.</li>
            <li>Easy YAML import. 5-minute setup for most users.</li>
            <li>Includes bonus: Tariff-aware scheduler + ROI simulator CLI</li>
          </ul>
        </div>

        <div class="section">
          <h2>What's Included</h2>
          <ul>
            <li><strong>ha_solar_forecaster.yaml</strong> — Core production prediction + battery logic</li>
            <li><strong>ha_battery_scheduler.yaml</strong> — Tariff + forecast driven charge/discharge automation</li>
            <li><strong>ha_tariff_roi_simulator.py</strong> — CLI tool to model your exact savings (with tests)</li>
            <li>Full documentation + example configurations</li>
            <li>Future-proof: Easy to extend with new sensors</li>
          </ul>
        </div>

        <div class="section">
          <h2>Real User Results (from early testers)</h2>
          <blockquote>
            <p>"Cut my evening peak import by 65% in the first week." — UK HA user with 5.2kWh battery</p>
          </blockquote>
          <blockquote>
            <p>"Finally understand why my panels underperform on cloudy days." — Another tester</p>
          </blockquote>
        </div>

        <div class="section cta-section">
          <a 
            href="https://gumroad.com/l/ha-solar-forecaster?utm_source=filce_uk&utm_medium=sales_page&utm_campaign=solar_forecaster_pack" 
            class="cta-button"
            data-gumroad-product="ha-solar-forecaster"
          >
            Get the Pack Now
          </a>
        </div>

        <div class="section affiliate">
          <h2>Amazon Hardware Recommendations (affiliate)</h2>
          <p>Pair this with quality solar + battery gear. (filce-21 tag active)</p>
          <ul>
            <li><a href="https://www.amazon.co.uk/s?k=solar+panel+kit&tag=filce-21">Recommended solar panel kits</a></li>
            <li><a href="https://www.amazon.co.uk/s?k=home+battery+storage&tag=filce-21">Popular home battery systems</a></li>
          </ul>
          <p class="utm-note">Purchases via these links support the project at no extra cost to you.</p>
        </div>

        <footer class="page-footer">
          <p>Generated as part of autonomous revenue system • July 2026 • Compatible with Home Assistant 2024.1+</p>
          <p>Part of the filce.uk Home Automation series.</p>
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .cta-section {
    text-align: center;
    margin: 2rem 0;
  }
  
  .cta-button {
    background: #1a5f7a;
    color: white;
    padding: 15px 30px;
    text-decoration: none;
    border-radius: 8px;
    display: inline-block;
    margin: 20px 0;
    font-weight: bold;
    font-size: 1.1em;
    transition: background 0.2s;
  }
  
  .cta-button:hover {
    background: #0d3d52;
  }
  
  .utm-note {
    font-size: 0.85em;
    color: #666;
    margin-top: 0.5rem;
  }
  
  .proof {
    background: #f0f7fa;
    padding: 1.5rem;
    border-left: 5px solid #1a5f7a;
    margin: 2rem 0;
  }
  
  .affiliate {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }
  
  blockquote {
    font-style: italic;
    border-left: 4px solid #1a5f7a;
    padding-left: 1rem;
    color: #444;
  }
  
  .page-footer {
    margin-top: 3rem;
    font-size: 0.9em;
    color: #666;
    text-align: center;
  }
</style>

<script>
  // Local click logging (Plausible global handler already tracks gumroad links)
  console.log('HA Solar Forecaster sales page loaded. SEO + analytics ready.');
</script>

<!-- Structured data for rich results: Product + Offer -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "HA Solar Production Forecaster + Battery Scheduler",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Home Assistant",
  "description": description,
  "offers": {
    "@type": "Offer",
    "price": "19.00",
    "priceCurrency": "GBP",
    "availability": "https://schema.org/InStock",
    "url": "https://gumroad.com/l/ha-solar-forecaster?utm_source=filce_uk&utm_medium=sales_page&utm_campaign=solar_forecaster_pack"
  },
  "author": {
    "@type": "Person",
    "name": "Sam Filce"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Filce.uk"
  }
})} />
