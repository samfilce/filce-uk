---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Caravan Awning Brand Fit Matrix UK 2026 — Thule, Dometic, Fiamma & Isabella';
const description = 'Look up caravan awning brands by rail, slider and end-cap family, then jump to the most likely spare-part search terms and tracked buy paths.';
const canonicalPath = '/caravan-awning-brand-fit-matrix/';

const related = {
  partsGuide: '/caravan-awning-parts-compatibility-guide/',
  careFinder: '/caravan-awning-care-finder/',
  seasonalChecklist: '/caravan-awning-seasonal-checklist/',
  repairEstimator: '/caravan-awning-repair-estimator/',
  moistureControl: '/posts/best-caravan-moisture-control-products-for-winter-storage-uk/',
};

const amazon = {
  thule: 'https://www.amazon.co.uk/s?k=Thule+awning+spare+parts&tag=filce-21',
  dometic: 'https://www.amazon.co.uk/s?k=Dometic+awning+spare+parts&tag=filce-21',
  fiamma: 'https://www.amazon.co.uk/s?k=Fiamma+awning+spare+parts&tag=filce-21',
  isabella: 'https://www.amazon.co.uk/s?k=Isabella+awning+spare+parts&tag=filce-21',
  railStrips: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+strips&tag=filce-21',
  railStoppers: 'https://www.amazon.co.uk/s?k=caravan+awning+rail+stoppers&tag=filce-21',
  search: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
};

const faqItems = [
  {
    question: 'Do I need the exact model number?',
    answer: 'No. The brand plus the visible hardware family is often enough to get to the right spare-part search.',
  },
  {
    question: 'What if the brand is unclear?',
    answer: 'Use the generic backup search, then compare the rail, slider and end-cap photos against the matrix.',
  },
  {
    question: 'When should I move to the compatibility guide?',
    answer: 'If the brand is known but the part family still looks ambiguous, open the compatibility guide and check the rail profile and fittings.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="website" category="Tools">
  <section class="hero-shell">
    <div class="container hero-grid">
      <div class="card hero-copy">
        <p class="eyebrow">Brand lookup matrix · caravan awnings</p>
        <h1>Identify the brand first, then buy the spare part family that actually matches.</h1>
        <p class="lede">
          This page is for visitors who know the awning brand or can recognise the profile from a photo, but do not yet know the exact part number. Instead of measuring width or drop, use the brand-level matrix to cross-reference rail, slider and end-cap families, then push the shopper into the most likely spare-part search.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="#brand-matrix" data-plausible-event="awning_brand_matrix_jump_click" data-plausible-prop-surface="hero">Open the matrix</a>
          <a class="btn secondary" href={related.partsGuide} data-plausible-event="awning_brand_matrix_parts_guide_click" data-plausible-prop-surface="hero">Use the parts guide</a>
          <a class="btn green" href={related.careFinder} data-plausible-event="awning_brand_matrix_care_finder_click" data-plausible-prop-surface="hero">Check care products</a>
        </div>
        <p class="microcopy">Revenue mechanism: brand-aware lookup cuts irrelevant click-outs, moves high-intent visitors to a tighter spare-part search, and gives a cleaner route to the affiliate result that best matches their awning family.</p>
        <p class="small help-link">Need a slower fit-check before you buy? <a href={related.partsGuide} data-plausible-event="awning_brand_matrix_help_link_click" data-plausible-prop-surface="hero-help">Read the parts compatibility guide</a>.</p>
        <p class="small help-link">Want a seasonal maintenance pass before you order spares? <a href={related.seasonalChecklist} data-plausible-event="awning_brand_matrix_seasonal_checklist_help_link_click" data-plausible-prop-surface="hero-help">Open the seasonal checklist</a>.</p>
      </div>

      <div class="card hero-panel" aria-label="Brand lookup summary">
        <div class="metric">
          <div class="label">Start with</div>
          <div class="value">Brand + photo</div>
          <div class="sub">Thule, Dometic, Fiamma or Isabella are usually enough to narrow the family</div>
        </div>
        <div class="metric">
          <div class="label">Then cross-reference</div>
          <div class="value">Rail, slider, stopper, end cap</div>
          <div class="sub">the part family matters more than vague “fits most” listings</div>
        </div>
        <div class="metric">
          <div class="label">Best next buy</div>
          <div class="value" id="hero-buy">Thule awning spare parts</div>
          <div class="sub" id="hero-sub">brand-level search path with the highest match probability</div>
        </div>
        <div class="metric">
          <div class="label">Backup route</div>
          <div class="value" id="hero-backup">Generic caravan awning spares</div>
          <div class="sub">use when the brand stamp is worn or the label is missing</div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section related-reading-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Related reading</h2>
        <p class="section-sub">If you are still choosing the right awning path, keep moving through the support pages before you buy the wrong spare part.</p>
      </div>
      <div class="card">
        <ul class="rules">
          <li><a href={related.partsGuide} data-plausible-event="awning_brand_related_parts_click" data-plausible-prop-surface="related-reading">Check the parts compatibility guide</a></li>
          <li><a href={related.careFinder} data-plausible-event="awning_brand_related_care_click" data-plausible-prop-surface="related-reading">Compare the care products</a></li>
          <li><a href={related.seasonalChecklist} data-plausible-event="awning_brand_related_checklist_click" data-plausible-prop-surface="related-reading">Open the seasonal checklist</a></li>
          <li><a href={related.repairEstimator} data-plausible-event="awning_brand_related_repair_click" data-plausible-prop-surface="related-reading">Estimate the likely repair</a></li>
          <li><a href={related.moistureControl} data-plausible-event="awning_brand_related_moisture_click" data-plausible-prop-surface="related-reading">Compare moisture control products</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="finder-section">
    <div class="container finder-grid-2">
      <div class="card chooser" id="brand-matrix">
        <h2 class="section-title">Brand-fit matrix</h2>
        <p class="section-subtitle">Pick the brand you think you have. The recommendation updates with the most likely rail, slider and end-cap search terms, plus a backup route if the label is faded or the part number is missing.</p>

        <div class="field-grid">
          <label class="field">
            <span>Awning brand</span>
            <select id="brand">
              <option value="thule">Thule</option>
              <option value="dometic">Dometic</option>
              <option value="fiamma">Fiamma</option>
              <option value="isabella">Isabella</option>
              <option value="unknown">Brand not clear yet</option>
            </select>
          </label>

          <label class="field">
            <span>What do you recognise?</span>
            <select id="clue">
              <option value="rail">Rail / track profile</option>
              <option value="slider">Slider / carrier family</option>
              <option value="endcap">End cap / side plate</option>
              <option value="label">Badge / label / model sticker</option>
            </select>
          </label>

          <label class="field">
            <span>Condition</span>
            <select id="condition">
              <option value="spare">I need a spare part</option>
              <option value="missing">Part is missing</option>
              <option value="broken">Part is broken</option>
              <option value="unsure">Not sure yet</option>
            </select>
          </label>
        </div>

        <div class="results" aria-live="polite">
          <div class="result-card">
            <div class="result-label">Recommended brand search</div>
            <div class="result-title" id="result-title">Thule awning spare parts</div>
            <div class="result-copy" id="result-copy">Use the brand name first, then compare the obvious hardware family in the photos before ordering.</div>
          </div>

          <div class="result-card">
            <div class="result-label">Most likely search terms</div>
            <div class="result-title" id="result-terms">Thule awning rail slider, rail stopper, end cap, side plate</div>
            <div class="result-copy" id="result-terms-copy">These are the phrases that tend to surface the right listings faster than a generic awning search, especially when the rail section or stop has failed.</div>
          </div>

          <div class="result-card">
            <div class="result-label">Suggested action</div>
            <div class="result-copy" id="result-action">Open the brand search, check the hardware family in the photos, and only then compare model notes or dimensions.</div>
          </div>

          <div class="cta-row compact">
            <a class="btn primary" id="primary-link" href={amazon.thule} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_matrix_primary_click" data-plausible-prop-surface="results">Open brand search</a>
            <a class="btn secondary" id="secondary-link" href={amazon.search} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_matrix_secondary_click" data-plausible-prop-surface="results">Open backup search</a>
            <button class="btn green" type="button" id="copy-brief" data-plausible-event="awning_brand_matrix_copy_brief_click" data-plausible-prop-surface="results">Copy lookup brief</button>
          </div>
          <p class="small status" id="copy-status" aria-live="polite"></p>
        </div>
      </div>

      <aside class="card sidebar">
        <h2 class="section-title">Cross-reference rules</h2>
        <ul class="rules">
          <li><strong>Brand stamp first:</strong> a readable badge or label saves time and reduces the wrong spare-part search.</li>
          <li><strong>Track family next:</strong> bead rails, cassette housings and clip sliders are usually different buying paths.</li>
          <li><strong>Photo the end cap:</strong> the cap or side plate shape often reveals the real family faster than the model text.</li>
          <li><strong>Use the model sticker:</strong> if the brand matches but the part looks unusual, the sticker narrows the next search.</li>
          <li><strong>If the label is gone:</strong> fall back to the generic brand + part family search and compare photos.</li>
        </ul>

        <div class="cta-stack">
          <a class="btn primary" href={amazon.thule} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_thule_search_click" data-plausible-prop-surface="sidebar">Shop Thule spares</a>
          <a class="btn secondary" href={amazon.dometic} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_dometic_search_click" data-plausible-prop-surface="sidebar">Shop Dometic spares</a>
          <a class="btn secondary" href={amazon.fiamma} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_fiamma_search_click" data-plausible-prop-surface="sidebar">Shop Fiamma spares</a>
          <a class="btn secondary" href={amazon.isabella} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_isabella_search_click" data-plausible-prop-surface="sidebar">Shop Isabella spares</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="comparison-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Brand lookup matrix</h2>
        <p class="section-sub">This table is designed for photo-led shopping: brand name, likely hardware family, then the search terms that usually surface the right spare parts.</p>
      </div>

      <div class="comparison-grid brand-grid">
        <article class="product-card">
          <p class="product-kicker">Thule</p>
          <h3>Rail-first search family</h3>
          <p>Look for <strong>Thule awning rail slider</strong>, <strong>Thule rail stopper</strong>, <strong>Thule end cap</strong>, and <strong>Thule side plate</strong> before you widen the search.</p>
          <a href={amazon.thule} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_thule_card_click" data-plausible-prop-surface="matrix">View Thule search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Dometic</p>
          <h3>Cassette and track family</h3>
          <p>Try <strong>Dometic awning cassette</strong>, <strong>Dometic rail slider</strong>, <strong>Dometic rail stopper</strong>, and <strong>Dometic end cap</strong> when the housing looks branded.</p>
          <a href={amazon.dometic} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_dometic_card_click" data-plausible-prop-surface="matrix">View Dometic search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Fiamma</p>
          <h3>Clip, bracket and carriage family</h3>
          <p>Search <strong>Fiamma awning bracket</strong>, <strong>Fiamma slider</strong>, and <strong>Fiamma side cap</strong> when the profile is slim and modular.</p>
          <a href={amazon.fiamma} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_fiamma_card_click" data-plausible-prop-surface="matrix">View Fiamma search</a>
        </article>

        <article class="product-card">
          <p class="product-kicker">Isabella</p>
          <h3>Fabric edge and support family</h3>
          <p>Use <strong>Isabella awning spare parts</strong>, <strong>Isabella rail</strong>, <strong>Isabella stopper</strong>, and <strong>Isabella end cap</strong> if the awning is more tent-like or touring oriented.</p>
          <a href={amazon.isabella} target="_blank" rel="noopener sponsored" data-plausible-event="awning_brand_isabella_card_click" data-plausible-prop-surface="matrix">View Isabella search</a>
        </article>
      </div>
    </div>
  </section>

  <section class="guide-section">
    <div class="container guide-grid">
      <article class="card guide-card">
        <h2>How the lookup should work</h2>
        <p>Take a close photo of the awning badge, the rail profile, and the end cap or side plate. If the brand is visible, start with that exact brand plus the part family. If the badge is gone, use the matrix above to choose the most likely family and compare seller photos.</p>
        <div class="cta-row">
          <a class="btn primary" href={related.partsGuide} data-plausible-event="awning_brand_parts_mid_click" data-plausible-prop-surface="guide">Open the parts guide</a>
          <a class="btn secondary" href={related.repairEstimator} data-plausible-event="awning_brand_repair_mid_click" data-plausible-prop-surface="guide">Open the repair estimator</a>
        </div>
        <p class="small">If you want a slower fit-check before buying, <a href={related.partsGuide} data-plausible-event="awning_brand_parts_help_link_click" data-plausible-prop-surface="guide">read the parts compatibility guide</a>.</p>
        <p class="small">For winter-storage prep, compare with <a href={related.moistureControl} data-plausible-event="awning_brand_moisture_related_click" data-plausible-prop-surface="guide">the moisture-control comparison</a>.</p>
      </article>

      <article class="card guide-card">
        <h2>What this page is selling</h2>
        <ul>
          <li>Brand-level searches for Thule, Dometic, Fiamma and Isabella spare parts.</li>
          <li>Cross-reference terms for rails, sliders, end caps and side plates.</li>
          <li>Backup generic searches when the badge or model sticker is missing.</li>
          <li>High-intent click paths that can convert without forcing a full compatibility diagnosis.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="faq-section">
    <div class="container faq-grid">
      <article class="card faq-card">
        <h2>FAQ</h2>
        <details>
          <summary>Do I need the exact model number?</summary>
          <p>No. The brand plus the visible hardware family is often enough to get to the right spare-part search.</p>
        </details>
        <details>
          <summary>What if the brand is unclear?</summary>
          <p>Use the generic backup search, then compare the rail, slider and end-cap photos against the matrix.</p>
        </details>
        <details>
          <summary>When should I move to the compatibility guide?</summary>
          <p>If the brand is known but the part family still looks ambiguous, open the compatibility guide and check the rail profile and fittings.</p>
        </details>
      </article>

      <article class="card faq-card">
        <h2>Affiliate disclosure</h2>
        <p>Some links on this page are affiliate links. If someone buys through them, I may earn a commission at no extra cost to the buyer. That helps fund the site and keeps the buying guides free.</p>
        <p class="small">For related awning content, compare with <a href={related.careFinder}>Caravan awning care finder</a>, <a href={related.partsGuide}>parts compatibility guide</a> and the repair estimator above.</p>
      </article>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <section class="container card copy-card" style="margin-bottom: 4rem;">
    <div class="copy-grid">
      <div>
        <h3>Copyable lookup brief</h3>
        <p>Use this when you want a quick note to paste into a browser search, WhatsApp message, or shopping list.</p>
        <textarea id="brief-output" readonly></textarea>
      </div>
      <div class="copy-actions">
        <button type="button" class="btn primary" id="copy-fit-brief" data-plausible-event="awning_brand_copy_click" data-plausible-prop-surface="copy-panel">Copy lookup brief</button>
        <p class="small status" id="copy-status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <style>
    .related-reading-section {
      padding-top: 0;
    }

    .brand-grid .product-card h3 {
      margin-top: 0;
    }

    .brand-grid .product-card p {
      margin-bottom: 0.75rem;
    }
  </style>

  <script>
    const catalog = {
      thule: {
        title: 'Thule awning spare parts',
        terms: 'Thule awning rail slider, end cap, side plate',
        backup: 'Generic caravan awning spare parts',
        primary: 'https://www.amazon.co.uk/s?k=Thule+awning+spare+parts&tag=filce-21',
        secondary: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
        action: 'Start with Thule + the visible hardware family, then compare the seller photos before ordering.',
      },
      dometic: {
        title: 'Dometic awning spare parts',
        terms: 'Dometic awning cassette, rail slider, end cap',
        backup: 'Generic caravan awning spare parts',
        primary: 'https://www.amazon.co.uk/s?k=Dometic+awning+spare+parts&tag=filce-21',
        secondary: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
        action: 'Start with Dometic + the visible hardware family, then compare the seller photos before ordering.',
      },
      fiamma: {
        title: 'Fiamma awning spare parts',
        terms: 'Fiamma awning bracket, slider, side cap',
        backup: 'Generic caravan awning spare parts',
        primary: 'https://www.amazon.co.uk/s?k=Fiamma+awning+spare+parts&tag=filce-21',
        secondary: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
        action: 'Start with Fiamma + the visible hardware family, then compare the seller photos before ordering.',
      },
      isabella: {
        title: 'Isabella awning spare parts',
        terms: 'Isabella awning rail, end cap, support part',
        backup: 'Generic caravan awning spare parts',
        primary: 'https://www.amazon.co.uk/s?k=Isabella+awning+spare+parts&tag=filce-21',
        secondary: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
        action: 'Start with Isabella + the visible hardware family, then compare the seller photos before ordering.',
      },
      unknown: {
        title: 'Generic caravan awning spare parts',
        terms: 'caravan awning rail slider, end cap, spare part',
        backup: 'Brand search after photo check',
        primary: 'https://www.amazon.co.uk/s?k=caravan+awning+spare+parts&tag=filce-21',
        secondary: 'https://www.amazon.co.uk/s?k=caravan+awning+brand+spare+parts&tag=filce-21',
        action: 'Use the generic spare-parts search first, then narrow to the brand once the badge or shape is visible.',
      },
    };

    const els = {
      brand: document.getElementById('brand'),
      clue: document.getElementById('clue'),
      condition: document.getElementById('condition'),
      heroBuy: document.getElementById('hero-buy'),
      heroSub: document.getElementById('hero-sub'),
      heroBackup: document.getElementById('hero-backup'),
      resultTitle: document.getElementById('result-title'),
      resultTerms: document.getElementById('result-terms'),
      resultTermsCopy: document.getElementById('result-terms-copy'),
      resultAction: document.getElementById('result-action'),
      primaryLink: document.getElementById('primary-link'),
      secondaryLink: document.getElementById('secondary-link'),
      copyBrief: document.getElementById('copy-fit-brief'),
      briefOutput: document.getElementById('brief-output'),
      copyStatus: document.getElementById('copy-status'),
    };

    const clueLabel = {
      rail: 'rail / track profile',
      slider: 'slider / carrier family',
      endcap: 'end cap / side plate',
      label: 'badge / label / model sticker',
    };

    const conditionLabel = {
      spare: 'spare part',
      missing: 'missing part',
      broken: 'broken part',
      unsure: 'unclear part',
    };

    function update() {
      const selected = catalog[els.brand.value] ?? catalog.unknown;
      const clue = clueLabel[els.clue.value] ?? 'brand photo';
      const condition = conditionLabel[els.condition.value] ?? 'spare part';

      els.heroBuy.textContent = selected.title;
      els.heroSub.textContent = `Best next search when the clue is the ${clue}`;
      els.heroBackup.textContent = selected.backup;
      els.resultTitle.textContent = selected.title;
      els.resultTerms.textContent = selected.terms;
      els.resultTermsCopy.textContent = `Condition: ${condition}. When the hardware family is obvious, search that family first rather than a generic awning listing.`;
      els.resultAction.textContent = selected.action;
      els.primaryLink.href = selected.primary;
      els.secondaryLink.href = selected.secondary;
      els.briefOutput.value = [
        `Brand: ${els.brand.options[els.brand.selectedIndex]?.text ?? 'Unknown brand'}`,
        `Clue: ${clue}`,
        `Condition: ${condition}`,
        `Recommended search: ${selected.title}`,
        `Most likely terms: ${selected.terms}`,
        `Backup search: ${selected.backup}`,
      ].join('\n');
    }

    els.brand.addEventListener('change', update);
    els.clue.addEventListener('change', update);
    els.condition.addEventListener('change', update);

    els.copyBrief.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(els.briefOutput.value);
        els.copyStatus.textContent = 'Lookup brief copied to clipboard.';
      } catch (error) {
        els.copyStatus.textContent = 'Copy failed — select the text and copy it manually.';
      }
    });

    update();
  </script>
</BaseLayout>
